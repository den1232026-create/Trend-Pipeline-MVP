# Copy to .env (gitignored) — never commit real secrets
#   copy .env.example .env

# Reddit (Trends)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=trend-meme-pipeline/0.1 by your_reddit_username
REDDIT_SUBREDDITS=memes,aivideo,StableDiffusion

# GPTunnel
GPTUNNEL_API_KEY=
GPTUNNEL_BASE_URL=https://gptunnel.ru/v1
GPTUNNEL_MEDIA_BASE_URL=https://gptunnel.ru/api/v2
GPTUNNEL_CHAT_MODEL=gpt-4o-mini
GPTUNNEL_IMAGE_MODEL=faceswap
GPTUNNEL_SCENE_MODEL=flux-schnell
# Optional: force media input role (face|source|image|...)
# GPTUNNEL_IMAGE_INPUT_ROLE=face
MOCK_GENERATE=1

# Python
DATA_DIR=data
PYTHON_HOST=127.0.0.1
PYTHON_PORT=8000

# Node BFF
PORT=3001
PYTHON_BASE_URL=http://127.0.0.1:8000

# Web (Vite reads root .env via envDir)
VITE_API_BASE_URL=/api
VITE_USE_FIXTURES=0
